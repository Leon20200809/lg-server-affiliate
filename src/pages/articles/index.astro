---
import { getCollection } from "astro:content";
import ArticleCard from "../../components/ArticleCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

// 記事を公開日の新しい順へ並べる
const articles = (await getCollection("articles")).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---

<BaseLayout title="技術記事｜XServer実践ノート" description="XServerを実際に利用した際の課題、調査、解決、確認方法をまとめた記事一覧です。">
  <section class="page-hero"><div class="container narrow"><p class="eyebrow">ARTICLES</p><h1>技術記事</h1><p>困ったことから確認結果まで、実体験を軸に整理します。</p></div></section>
  <section class="section"><div class="container grid grid--two">{articles.map((article) => <ArticleCard href={`/articles/${article.id}/`} {...article.data} />)}</div></section>
</BaseLayout>
